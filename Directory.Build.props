<Project>

  <!--
    ImageSharp 3.1.12 is used by the tests only (tests/pViewer.Tests), as a second opinion on what
    pViewer reads and writes: pViewer itself moved to Skia, and Regression11Tests fails if
    ImageSharp ever comes back into it. Its advisories of October 2026, fixed only in 4.1.2 (4.x
    needs a license key at build time), are silenced here one by one: the tests feed it nothing
    but pictures they make themselves. Any new advisory still shows up as NU1902/NU1903.
  -->
  <ItemGroup>
    <!-- BigTIFF directory count keeps the decoder in a loop -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <!-- ICC lookup table allocation -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <!-- HistogramEqualization -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <!-- TIFF encoder with CCITT T4 / T6 compression -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
  </ItemGroup>

</Project>
