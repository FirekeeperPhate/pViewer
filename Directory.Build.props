<Project>

  <!--
    ImageSharp 3.1.12 advisories that are fixed only in 4.1.2 (4.x needs a license key at build
    time, see src/pViewer/pViewer.csproj). Each one is silenced here only because pViewer was shown
    not to be exposed; tests/pViewer.Tests/Regression11Tests.cs keeps it that way. Any new advisory
    still shows up as NU1902/NU1903.
  -->
  <ItemGroup>
    <!-- BigTIFF directory count keeps the decoder in a loop: such files are refused before the
         ImageSharp fallback (ImageDecoder.IsUnsafeBigTiff) -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <!-- ICC lookup table allocation: in 3.1 only IccProfile.Entries parses a profile, and pViewer
         carries profiles as bytes without ever reading their entries -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <!-- HistogramEqualization: never called, and pixels are always 8-bit Bgra32 -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <!-- TIFF encoder with CCITT T4 / T6 compression: TIFF is written by WIC, ImageSharp only
         writes WebP and GIF -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
  </ItemGroup>

</Project>
