<Window x:Class="pViewer.Views.TextStyleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Carattere e colore del testo" Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Carattere" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox x:Name="FontBox" Grid.Column="1" IsEditable="True" SelectionChanged="Any_Changed" LostFocus="Any_LostFocus" />
            <TextBlock Grid.Row="2" Text="Dimensione" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="SizeBox" Width="80" TextChanged="Size_Changed" />
                <TextBlock Text="pixel dell'immagine" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7" />
            </StackPanel>
            <TextBlock Grid.Row="4" Text="Stile" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                <CheckBox x:Name="BoldBox" Content="Grassetto" Click="Any_Click" Margin="0,0,16,0" />
                <CheckBox x:Name="ItalicBox" Content="Corsivo" Click="Any_Click" />
            </StackPanel>
            <TextBlock Grid.Row="6" Text="Colore" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                <Border x:Name="ColorSwatch" Width="40" Height="28" CornerRadius="4" BorderThickness="1" BorderBrush="Gray" />
                <Button Content="Scegli…" Margin="8,0,0,0" Click="Color_Click" />
            </StackPanel>
        </Grid>
        <Border Margin="0,16,0,0" Padding="12" CornerRadius="6" Background="#FF2A2A2A" Height="90" ClipToBounds="True">
            <TextBlock x:Name="PreviewText" Text="AaBbCc 123 àèìòù" VerticalAlignment="Center" />
        </Border>
        <TextBlock x:Name="ErrorText" Foreground="#FFFF6B5E" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" IsDefault="True" MinWidth="90" Click="Ok_Click" Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Annulla" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
