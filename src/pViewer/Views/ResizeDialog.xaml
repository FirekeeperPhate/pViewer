<Window x:Class="pViewer.Views.ResizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ridimensiona" Width="380" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock x:Name="OriginalText" Opacity="0.7" Margin="0,0,0,12" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Larghezza" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox x:Name="WidthBox" Grid.Column="1" TextChanged="WidthBox_TextChanged" />
            <TextBlock Grid.Column="2" Text="px" VerticalAlignment="Center" Margin="8,0,0,0" />
            <TextBlock Grid.Row="2" Text="Altezza" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox x:Name="HeightBox" Grid.Row="2" Grid.Column="1" TextChanged="HeightBox_TextChanged" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="px" VerticalAlignment="Center" Margin="8,0,0,0" />
            <TextBlock Grid.Row="4" Text="Percentuale" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox x:Name="PercentBox" Grid.Row="4" Grid.Column="1" TextChanged="PercentBox_TextChanged" />
            <TextBlock Grid.Row="4" Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>
        <CheckBox x:Name="KeepRatio" Content="Mantieni le proporzioni" IsChecked="True" Margin="0,12,0,0" />
        <TextBlock x:Name="ErrorText" Foreground="#FFFF6B5E" Margin="0,6,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="OK" IsDefault="True" MinWidth="90" Click="Ok_Click" Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Annulla" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
