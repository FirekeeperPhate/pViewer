<Window x:Class="pViewer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impostazioni" Width="560" Height="640" MinHeight="400" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="20,12" BorderThickness="0,1,0,0" BorderBrush="#30808080">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Valori predefiniti" Click="Defaults_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="OK" IsDefault="True" MinWidth="90" Click="Ok_Click" Style="{DynamicResource AccentButtonStyle}" />
                    <Button Content="Annulla" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,0,24,16">
                <TextBlock Text="Aspetto" Style="{StaticResource Section}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Tema" VerticalAlignment="Center" />
                    <ComboBox x:Name="ThemeBox" Grid.Column="1">
                        <ComboBoxItem Content="Scuro" />
                        <ComboBoxItem Content="Chiaro" />
                        <ComboBoxItem Content="Come Windows" />
                    </ComboBox>
                    <TextBlock Grid.Row="2" Text="Vista predefinita" VerticalAlignment="Center" />
                    <ComboBox x:Name="ViewModeBox" Grid.Row="2" Grid.Column="1">
                        <ComboBoxItem Content="Adatta se più grande" />
                        <ComboBoxItem Content="Adatta alla finestra" />
                        <ComboBoxItem Content="Riempi la finestra" />
                        <ComboBoxItem Content="Adatta alla larghezza" />
                        <ComboBoxItem Content="Adatta all'altezza" />
                    </ComboBox>
                </Grid>
                <CheckBox x:Name="PixelatedBox" Content="Mostra i pixel netti quando lo zoom supera il 250%" Margin="0,10,0,0" />

                <TextBlock Text="Apertura" Style="{StaticResource Section}" />
                <CheckBox x:Name="AutoRotateBox" Content="Raddrizza automaticamente le foto (orientamento EXIF)" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Archivi e fumetti si aprono in" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <ComboBox x:Name="ArchiveLayoutBox" Grid.Column="1">
                        <ComboBoxItem Content="Pagina singola" />
                        <ComboBoxItem Content="Manga (destra → sinistra)" />
                        <ComboBoxItem Content="Comic (sinistra → destra)" />
                    </ComboBox>
                </Grid>

                <TextBlock Text="File" Style="{StaticResource Section}" />
                <CheckBox x:Name="ConfirmDeleteBox" Content="Chiedi conferma prima di eliminare" />
                <CheckBox x:Name="RecycleBox" Content="Elimina spostando nel Cestino" />
                <CheckBox x:Name="ConfirmOverwriteBox" Content="Chiedi conferma prima di sovrascrivere il file originale" />
                <CheckBox x:Name="ConfirmDiscardBox" Content="Avvisa se si lascia un'immagine con modifiche non salvate" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Qualità JPEG e WebP" VerticalAlignment="Center" />
                    <Slider x:Name="QualitySlider" Grid.Column="1" Minimum="10" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=QualitySlider}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <TextBlock Text="Strumenti di modifica" Style="{StaticResource Section}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Selezione del ritaglio" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CropColorButton" Width="44" Height="28" MinWidth="0" MinHeight="0" Padding="0" Click="CropColor_Click" ToolTip="Colore" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="Rettangolo" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="RectColorButton" Width="44" Height="28" MinWidth="0" MinHeight="0" Padding="0" Click="RectColor_Click" ToolTip="Colore" />
                        <TextBox x:Name="RectThicknessBox" Width="70" Margin="12,0,0,0" />
                        <TextBlock Text="px di spessore" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="4" Text="Bordo nero/bianco" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="BorderThicknessBox" Width="70" />
                        <TextBlock Text="px" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="6" Text="Testo" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Carattere e colore…" Click="TextStyle_Click" />
                        <TextBlock x:Name="TextStyleSummary" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7" />
                    </StackPanel>
                    <TextBlock Grid.Row="8" Text="Presentazione" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="SlideshowBox" Width="70" />
                        <TextBlock Text="secondi (pulsante della barra)" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ErrorText" Foreground="#FFFF6B5E" TextWrapping="Wrap" Margin="0,12,0,0" />
                <TextBlock x:Name="PathText" TextWrapping="Wrap" Opacity="0.5" FontSize="12" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
