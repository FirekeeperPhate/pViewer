<Window x:Class="pViewer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="560" Height="640" MinHeight="400" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="20,12" BorderThickness="0,1,0,0" BorderBrush="#30808080">
            <StackPanel>
                <!-- Outside the scrolling area, so a validation error is always visible -->
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibility}}" />
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="Defaults" Click="Defaults_Click" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="OK" IsDefault="True" MinWidth="90" Click="Ok_Click" Style="{DynamicResource AccentButtonStyle}" />
                        <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,0,24,16">
                <TextBlock Text="Appearance" Style="{StaticResource Section}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Theme" VerticalAlignment="Center" />
                    <ComboBox x:Name="ThemeBox" Grid.Column="1">
                        <ComboBoxItem Content="Dark" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Same as Windows" />
                    </ComboBox>
                    <TextBlock Grid.Row="2" Text="Default view" VerticalAlignment="Center" />
                    <ComboBox x:Name="ViewModeBox" Grid.Row="2" Grid.Column="1">
                        <ComboBoxItem Content="Shrink to fit" />
                        <ComboBoxItem Content="Fit to window" />
                        <ComboBoxItem Content="Fill window" />
                        <ComboBoxItem Content="Fit width" />
                        <ComboBoxItem Content="Fit height" />
                    </ComboBox>
                </Grid>
                <CheckBox x:Name="PixelatedBox" Content="Show sharp pixels when zoomed beyond 250%" Margin="0,10,0,0" />
                <CheckBox x:Name="ToolbarBox" Content="Show the toolbar (T)" />
                <CheckBox x:Name="StatusBarBox" Content="Show the status bar" />

                <TextBlock Text="Opening" Style="{StaticResource Section}" />
                <CheckBox x:Name="AutoRotateBox" Content="Auto-rotate photos (EXIF orientation)" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Archives and comics open in" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <ComboBox x:Name="ArchiveLayoutBox" Grid.Column="1">
                        <ComboBoxItem Content="Single page" />
                        <ComboBoxItem Content="Manga (right to left)" />
                        <ComboBoxItem Content="Comic (left to right)" />
                    </ComboBox>
                </Grid>

                <TextBlock Text="File" Style="{StaticResource Section}" />
                <CheckBox x:Name="ConfirmDeleteBox" Content="Ask before deleting" />
                <CheckBox x:Name="RecycleBox" Content="Delete to the Recycle Bin" />
                <CheckBox x:Name="ConfirmOverwriteBox" Content="Ask before overwriting the original file" />
                <CheckBox x:Name="ConfirmDiscardBox" Content="Warn when leaving an image with unsaved changes" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="JPEG and WebP quality" VerticalAlignment="Center" />
                    <Slider x:Name="QualitySlider" Grid.Column="1" Minimum="10" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=QualitySlider}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <TextBlock Text="Editing tools" Style="{StaticResource Section}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Crop selection" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CropColorButton" Width="44" Height="28" MinWidth="0" MinHeight="0" Padding="0" Click="CropColor_Click" ToolTip="Color" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="Rectangle" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="RectColorButton" Width="44" Height="28" MinWidth="0" MinHeight="0" Padding="0" Click="RectColor_Click" ToolTip="Color" />
                        <TextBox x:Name="RectThicknessBox" Width="70" Margin="12,0,0,0" />
                        <TextBlock Text="px thick" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="4" Text="Black/white border" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="BorderThicknessBox" Width="70" />
                        <TextBlock Text="px" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="6" Text="Text" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Font and color…" Click="TextStyle_Click" />
                        <Border x:Name="TextColorSwatch" Width="16" Height="16" CornerRadius="3" BorderThickness="1" BorderBrush="#80808080" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TextStyleSummary" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7" />
                    </StackPanel>
                    <TextBlock Grid.Row="8" Text="Slideshow" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="SlideshowBox" Width="70" />
                        <TextBlock Text="seconds (toolbar button)" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Keyboard shortcuts" Style="{StaticResource Section}" />
                <TextBlock Text="Click + and press the new key combination (with Ctrl, Shift or Alt if you like). A key already used by another command is moved to this one." Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,6" />
                <TextBlock x:Name="HotkeyNote" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibility}}" />
                <StackPanel x:Name="HotkeysPanel" />
                <Button Content="Restore all default shortcuts" HorizontalAlignment="Left" Margin="0,10,0,0" Click="ResetHotkeys_Click" />

                <TextBlock x:Name="PathText" TextWrapping="Wrap" Opacity="0.5" FontSize="12" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
