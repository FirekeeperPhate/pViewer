<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>pViewer</RootNamespace>
    <AssemblyName>pViewer</AssemblyName>
    <ApplicationIcon>Assets\pv.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.Main runs before the Main that WPF generates for App.xaml (see Program.cs) -->
    <StartupObject>pViewer.Program</StartupObject>
    <Version>2.2.0</Version>
    <Product>pViewer</Product>
    <Authors>Phate</Authors>
    <Copyright>Copyright (C) 2013-2026 Phate</Copyright>
    <!-- ThemeMode (the Fluent theme) is still marked experimental in WPF -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WIC decodes; Skia does the animations, a second decoder, WebP saving, blur and sharpen
         (Imaging/SkiaImaging.cs). Its native part is named here only for the path of its notices. -->
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.153.1" GeneratePathProperty="true" />
    <!-- Background removal (Imaging/BackgroundRemover.cs): runs the ISNet network on the processor -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" GeneratePathProperty="true" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\pv.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Licenses of the bundled components: next to the exe (About links to it), in every install -->
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The notices of Skia and of the libraries inside libSkiaSharp.dll, as shipped with the package -->
    <None Include="$(PkgSkiaSharp_NativeAssets_Win32)\THIRD-PARTY-NOTICES.txt" Link="skiasharp-THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <!-- The same for ONNX Runtime -->
    <None Include="$(PkgMicrosoft_ML_OnnxRuntime)\ThirdPartyNotices.txt" Link="onnxruntime-THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="pViewer.Tests" />
  </ItemGroup>

  <!-- The debug symbols of Skia (90 MB) come with its package: not into the published folder -->
  <Target Name="LeaveOutNativeSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'libSkiaSharp.pdb'" />
      <!-- ONNX Runtime's import libraries are for C++ builds only -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.lib'" />
    </ItemGroup>
  </Target>

</Project>
